{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/cs",
      "destination": "/cs/index.html"
    },
    {
      "source": "/cs/result",
      "destination": "/cs/result.html"
    },
    {
      "source": "/cs/detail",
      "destination": "/cs/detail.html"
    },
    {
      "source": "/result",
      "destination": "/cs/result.html"
    },
    {
      "source": "/detail",
      "destination": "/cs/detail.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
