{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/services/(.*)",
      "dest": "/api/services.js"
    },
    {
      "src": "/api/services",
      "dest": "/api/services.js"
    },
    {
      "src": "/api/vehicles/(.*)",
      "dest": "/api/vehicles.js"
    },
    {
      "src": "/api/vehicles",
      "dest": "/api/vehicles.js"
    },
    {
      "src": "/api/reports/(.*)",
      "dest": "/api/reports.js"
    },
    {
      "src": "/api/reports",
      "dest": "/api/reports.js"
    },
    {
      "src": "/cs",
      "dest": "/public/cs/index.html"
    },
    {
      "src": "/cs/result",
      "dest": "/public/cs/result.html"
    },
    {
      "src": "/cs/detail",
      "dest": "/public/cs/detail.html"
    },
    {
      "src": "/result",
      "dest": "/public/cs/result.html"
    },
    {
      "src": "/detail",
      "dest": "/public/cs/detail.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
