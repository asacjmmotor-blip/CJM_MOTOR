{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/cs",
      "dest": "/public/cs/index.html"
    },
    {
      "src": "/cs/result",
      "dest": "/public/cs/result.html"
    },
    {
      "src": "/cs/detail",
      "dest": "/public/cs/detail.html"
    },
    {
      "src": "/result",
      "dest": "/public/cs/result.html"
    },
    {
      "src": "/detail",
      "dest": "/public/cs/detail.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
